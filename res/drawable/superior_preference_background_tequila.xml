<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/superior_pref_ripple">
    
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/superior_radius" />
        </shape>
    </item>

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="200%p"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="@color/tequila_card_gradient_start"
                android:endColor="@color/tequila_card_gradient_end" />
            <corners android:radius="@dimen/superior_radius" />
        </shape>
    </item>
</ripple>